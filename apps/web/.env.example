# twtdash web — environment variables
# Copy to `.env.local` for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Hosted AI (twtdash Pro) — server only
# ---------------------------------------------------------------------------

# Anthropic API key used by POST /api/categorize. Without it the endpoint
# returns 500 server_misconfigured and /api/health reports `ai: false`.
ANTHROPIC_API_KEY=

# Claude model for hosted categorization. Defaults to claude-opus-5-5 (best
# quality). claude-haiku-5-5 is far cheaper for high-volume use
# ($0.10 / $0.50 per million input / output tokens vs $4 / $20 for Opus).
TWTDASH_AI_MODEL=

# ---------------------------------------------------------------------------
# Licensing (LemonSqueezy License API) — server only
# ---------------------------------------------------------------------------

# Your LemonSqueezy store ID. When set, license keys from any other store are
# rejected. Strongly recommended in production.
LEMONSQUEEZY_STORE_ID=

# Optional comma-separated LemonSqueezy product IDs that count as twtdash Pro,
# e.g. "123456,123457". When set, keys for other products are rejected.
LEMONSQUEEZY_PRODUCT_IDS=

# Development escape hatch: a license key that is always valid ("Pro (dev)")
# without calling LemonSqueezy. NEVER set this in production.
TWTDASH_DEV_LICENSE=

# ---------------------------------------------------------------------------
# Public site configuration — inlined into the client at build time
# ---------------------------------------------------------------------------

# LemonSqueezy checkout link for twtdash Pro (falls back to #pricing).
NEXT_PUBLIC_CHECKOUT_URL=

# Store listings. When unset, install buttons point at the manual-install
# instructions on /install.
NEXT_PUBLIC_CHROME_STORE_URL=
NEXT_PUBLIC_FIREFOX_ADDON_URL=

# Canonical site URL used for metadata, Open Graph, sitemap and robots.
# Defaults to https://twtdash.app.
NEXT_PUBLIC_SITE_URL=https://twtdash.app
